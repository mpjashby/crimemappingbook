# Preserve links to chapters that were renumbered for the 2026 edition.
# These rules retain any filename or subpath after the chapter directory.
RewriteEngine On

RewriteRule ^10_place_data(?:/(.*))?$ 12_place_data/$1 [R=301,L,NE]
RewriteRule ^11_mapping_hotspots(?:/(.*))?$ 13_mapping_hotspots/$1 [R=301,L,NE]
RewriteRule ^12_messy_data(?:/(.*))?$ 10_messy_data/$1 [R=301,L,NE]
RewriteRule ^13_crime_series(?:/(.*))?$ 14_crime_series/$1 [R=301,L,NE]
RewriteRule ^14_writing_reports(?:/(.*))?$ 11_writing_reports/$1 [R=301,L,NE]

# Preserve links to chapters that were renumbered for the 2026 edition.
# These rules retain any filename or subpath after the chapter directory.
RewriteEngine On

# Preserve previous URLs for reports, examples and templates.
RewriteRule ^11_writing_reports/(?:www/)?medellin_homicides\.(qmd|html)$ resources/reports/medellin_homicides_map.$1 [R=301,L,NE]
RewriteRule ^11_writing_reports/(?:www/)?quarto_code_chunk(?:_echo)?\.(qmd|html)$ resources/examples/quarto_show_code.$1 [R=301,L,NE]
RewriteRule ^11_writing_reports/(?:www/)?quarto_code_chunk_noecho\.(qmd|html)$ resources/examples/quarto_hide_code.$1 [R=301,L,NE]
RewriteRule ^resources/example_quarto_report\.(qmd|html)$ resources/reports/medellin_homicides_table.$1 [R=301,L,NE]
RewriteRule ^resources/template\.R$ resources/templates/crime_mapping_script.R [R=301,L,NE]
RewriteRule ^resources/template\.qmd$ resources/templates/crime_mapping_report.qmd [R=301,L,NE]
RewriteRule ^resources/edmonton_fire_rescue_demand\.(qmd|html)$ resources/reports/edmonton_fire_rescue_demand.$1 [R=301,L,NE]
RewriteRule ^resources/yarra_waste_dumping\.(qmd|pdf)$ resources/reports/yarra_waste_dumping.$1 [R=301,L,NE]

RewriteRule ^10_place_data(?:/(.*))?$ 12_place_data/$1 [R=301,L,NE]
RewriteRule ^11_mapping_hotspots(?:/(.*))?$ 13_mapping_hotspots/$1 [R=301,L,NE]
RewriteRule ^12_messy_data(?:/(.*))?$ 10_messy_data/$1 [R=301,L,NE]
RewriteRule ^13_crime_series(?:/(.*))?$ 16_crime_series/$1 [R=301,L,NE]
RewriteRule ^14_writing_reports(?:/(.*))?$ 11_writing_reports/$1 [R=301,L,NE]

# This former chapter was split between several chapters in 2026.
RewriteRule ^(?:04|05)_code_with_style(?:/(?:index\.html)?)?$ code_with_style.html [R=301,L]

# Other chapter paths used by the 2024 and 2025 editions.
RewriteRule ^04_your_second_crime_map(?:/(.*))?$ 05_your_second_crime_map/$1 [R=301,L,NE]
RewriteRule ^06_map_context(?:/(.*))?$ 07_map_context/$1 [R=301,L,NE]
RewriteRule ^07_handling_bugs(?:/(.*))?$ 08_handling_bugs/$1 [R=301,L,NE]
RewriteRule ^15_no_maps(?:/(.*))?$ 14_no_maps/$1 [R=301,L,NE]
RewriteRule ^16_mapping_time(?:/(.*))?$ 15_mapping_time/$1 [R=301,L,NE]
RewriteRule ^00_setup(?:/(?:index\.html)?)?$ setup.html [R=301,L]
RewriteRule ^08_projects(?:/(?:index\.html)?)?$ 01_getting_started/ [R=301,L]
